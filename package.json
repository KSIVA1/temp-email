{
  "name": "inboxfornow",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "InboxForNow — a temporary inbox utility with the soul of a small magazine.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "infra:namecheap:verify": "node infra/scripts/namecheap-verify.mjs",
    "infra:namecheap:point-ns": "node infra/scripts/namecheap-point-ns.mjs",
    "infra:cf-add-zones": "node infra/scripts/cloudflare-add-zones.mjs",
    "infra:pages-dns": "node infra/scripts/cloudflare-pages-dns.mjs",
    "infra:email-routing": "bash infra/scripts/setup-email-routing.sh",
    "infra:verify-dns": "node infra/scripts/verify-dns.mjs",
    "infra:deploy-worker": "bash infra/scripts/deploy-worker.sh",
    "check:seo": "node --experimental-strip-types scripts/seo-check.mjs && npm run test:seo",
    "test:inbox": "node --experimental-strip-types --test scripts/inbox-session.test.mjs scripts/address-qr.test.mjs",
    "test:mail-fixtures": "npm --prefix workers/inboxfornow-api test -- --root ../.. --config workers/inboxfornow-api/vitest.config.ts scripts/email-fixtures.test.ts scripts/email-journey.test.ts",
    "seo:monitor": ".seo-cache/venv/bin/python scripts/seo-monitor.py",
    "seo:authorize": ".seo-cache/venv/bin/python scripts/seo-monitor.py --authorize",
    "seo:rankings": "node scripts/seo-rankings.mjs",
    "seo:dashboard": "node scripts/seo-dashboard.mjs && node scripts/seo-competitors.mjs",
    "test:seo": "node --test scripts/seo-rankings.test.mjs scripts/seo-dashboard.test.mjs scripts/seo-competitors.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^6.3.7",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "sharp": "^0.34.5"
  }
}
