---
import Layout from './Layout.astro';
import Header from '~/components/Header.astro';
interface Props {
  title: string;
  heading: string;
  description: string;
  label?: string;
  sections?: { id: string; title: string }[];
  article?: boolean;
}
const { title, heading, description, label = 'InboxForNow field guide', sections = [], article = true } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': article ? 'Article' : 'WebPage',
  '@id': `${url}#content`, url, headline: heading, name: heading, description,
  inLanguage: 'en', datePublished: '2026-10-11', dateModified: '2026-10-11',
  author: { '@type': 'Organization', name: 'InboxForNow', url: 'https://inboxfornow.com/about/' },
  publisher: { '@id': 'https://inboxfornow.com/#organization' },
  mainEntityOfPage: url,
};
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inboxfornow.com/' },
    ...(article ? [{ '@type': 'ListItem', position: 2, name: 'Help & guides', item: 'https://inboxfornow.com/guides/' }] : []),
    { '@type': 'ListItem', position: article ? 3 : 2, name: heading, item: url },
  ],
};
---
<Layout title={title} description={description} additionalJsonLd={[schema, breadcrumb]}>
  <Header inboxControls={false} />
  <main class="field-guide">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">InboxForNow</a> / <a href="/guides/">Help & guides</a></nav>
    <header class="intro">
      <span class="label"><span class="label__dot" aria-hidden="true"></span>{label}</span>
      <h1>{heading}</h1>
      <p class="dek">{description}</p>
      <p class="byline">By <a href="/about/">InboxForNow</a> · Reviewed <time datetime="2026-10-11">October 11, 2026</time></p>
    </header>
    <div class="reading-layout">
      {sections.length > 0 && <aside><nav aria-label="On this page"><span class="label">On this page</span><ol>{sections.map(s => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol></nav></aside>}
      <article class="copy"><slot /></article>
    </div>
    <footer class="guide-footer">
      <a class="btn btn--primary" href="/">Open a temporary inbox <span aria-hidden="true">↗</span></a>
      <nav aria-label="Footer"><a href="/guides/">All guides</a><a href="/use-case/">Platform limits</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
    </footer>
  </main>
  <script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('ifn-theme', next); } catch {}
    });
  </script>
</Layout>
<style>
  .field-guide { max-width: 1160px; margin: auto; padding: 2rem clamp(1.2rem, 4vw, 3rem) 4rem; }
  .crumbs { color: var(--text-2); font-size: var(--fs-small); margin-bottom: 3rem; }
  .intro { padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
  .intro h1 { max-width: 20ch; font-size: clamp(2.3rem, 5.2vw, 4.5rem); line-height: 1.05; margin: 1.2rem 0; }
  .dek { max-width: 65ch; font-size: 1.1rem; line-height: 1.65; }
  .byline { font-size: var(--fs-small); margin: 1.5rem 0 0; }
  .reading-layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 3.5rem; margin-top: 2.5rem; }
  .reading-layout:not(:has(aside)) { display: block; max-width: 75ch; }
  aside nav { position: sticky; top: 100px; }
  aside ol { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: .8rem; font-size: var(--fs-small); }
  aside a { text-decoration: none; color: var(--text-2); }
  aside a:hover { color: var(--text); text-decoration: underline; }
  .copy { min-width: 0; }
  .copy :global(section) { scroll-margin-top: 100px; margin-bottom: 2.5rem; }
  .copy :global(h2) { font-size: clamp(1.45rem, 3vw, 1.9rem); margin: 0 0 1rem; }
  .copy :global(h3) { font-size: 1.15rem; margin: 1.5rem 0 .7rem; }
  .copy :global(p), .copy :global(li) { line-height: 1.75; color: var(--text-2); }
  .copy :global(li + li) { margin-top: .7rem; }
  .copy :global(strong) { color: var(--text); }
  .copy :global(.note) { border-left: 3px solid var(--data); padding: 1rem 1.3rem; background: var(--surface-2); }
  .copy :global(pre) { overflow-x: auto; background: var(--surface-2); border: 1px solid var(--border); padding: 1.2rem; border-radius: var(--r-md); font: .85rem/1.7 var(--ff-mono); }
  .copy :global(.table-wrap) { overflow-x: auto; }
  .copy :global(table) { border-collapse: collapse; width: 100%; font-size: var(--fs-small); }
  .copy :global(th), .copy :global(td) { padding: .9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); line-height: 1.6; }
  .copy :global(th) { color: var(--text); background: var(--surface-2); }
  .copy :global(td) { color: var(--text-2); }
  .copy :global(.guide-link) { display: block; border-top: 1px solid var(--border); padding: 1.5rem 0; text-decoration: none; }
  .copy :global(.guide-link h2) { margin: 0 0 .5rem; }
  .copy :global(.guide-link p) { margin: 0; }
  .copy :global(.checklist) { list-style: none; padding: 0; }
  .copy :global(.checklist label) { display: flex; align-items: baseline; gap: .8rem; cursor: pointer; }
  .copy :global(input[type=checkbox]) { accent-color: var(--data); flex-shrink: 0; width: 1rem; height: 1rem; }
  .guide-footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
  .guide-footer nav { display: flex; flex-wrap: wrap; gap: 1rem; font-size: var(--fs-small); }
  @media (max-width: 760px) { .reading-layout { grid-template-columns: 1fr; gap: 1.5rem; } aside nav { position: static; } aside ol { display: flex; flex-wrap: wrap; gap: .6rem 1rem; } .crumbs { margin-bottom: 2rem; } }
</style>
