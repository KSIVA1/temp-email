---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import AddressCard from '~/components/AddressCard.astro';
import Postbox from '~/components/Postbox.astro';
import EmailReader from '~/components/EmailReader.astro';
import OnboardingTour from '~/components/OnboardingTour.astro';
import UseCaseHero from '~/components/UseCaseHero.astro';
import UseCaseHowItWorks from '~/components/UseCaseHowItWorks.astro';
import DiscordVerificationGuide from '~/components/DiscordVerificationGuide.astro';
import GitHubEmailGuide from '~/components/GitHubEmailGuide.astro';
import ChatGPTEmailGuide from '~/components/ChatGPTEmailGuide.astro';
import VenmoEmailGuide from '~/components/VenmoEmailGuide.astro';
import SteamEmailGuide from '~/components/SteamEmailGuide.astro';
import UseCaseFAQs from '~/components/UseCaseFAQs.astro';
import UseCaseRelated from '~/components/UseCaseRelated.astro';
import { platforms, type Platform } from '~/data/platforms';

export const getStaticPaths: GetStaticPaths = () => {
  return platforms.map((p) => ({
    params: { slug: p.slug },
    props: { platform: p },
  }));
};

interface Props { platform: Platform; }
const { platform } = Astro.props;

const guideOnly = ['venmo', 'steam'].includes(platform.slug);

const title = `Temporary Email for ${platform.name} — Limits & Guidance`;
const description = platform.slug === 'github'
  ? 'GitHub does not verify disposable email. Learn how to verify a lasting account address, use GitHub noreply for commit privacy, and check your Git email settings.'
  : platform.slug === 'chatgpt'
  ? 'Read ChatGPT email-verification and account-access guidance: identify your sign-in method, troubleshoot codes, and understand email-change requirements.'
  : platform.slug === 'venmo'
  ? 'Use lasting email for Venmo. Understand verification links, SMS prompts, registered-address errors and what an expired temporary inbox cannot recover.'
  : platform.slug === 'steam'
  ? 'Read Steam Guard email and mobile-code guidance, missing-message checks and the recovery limits of an expired temporary inbox.'
  : `Considering temporary email for ${platform.name}? Read the account recovery risks and email limitations before using a free disposable inbox from InboxForNow.`;

const pageUrl = `https://inboxfornow.com/use-case/${platform.slug}/`;
const imageAlt = platform.slug === 'github'
  ? 'Temporary email guidance and commit email privacy for GitHub — InboxForNow'
  : platform.slug === 'chatgpt'
  ? 'Temporary email limits and account access guidance for ChatGPT — InboxForNow'
  : platform.slug === 'venmo'
  ? 'Venmo email verification and temporary inbox limits — InboxForNow'
  : platform.slug === 'steam'
  ? 'Steam Guard email and temporary inbox limits — InboxForNow'
  : `Disposable email inbox for ${platform.name} verification codes — InboxForNow`;

// JSON-LD for the WebPage itself
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  name: `Temporary email for ${platform.name}`,
  description,
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': 'https://inboxfornow.com/#website' },
  about: { '@type': 'Thing', name: platform.name },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: 'https://inboxfornow.com/og.png',
    width: 1200,
    height: 630,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inboxfornow.com/' },
    { '@type': 'ListItem', position: 2, name: 'Platform guides', item: 'https://inboxfornow.com/use-case/' },
    { '@type': 'ListItem', position: 3, name: platform.name, item: pageUrl },
  ],
};

const kicker  = 'Free disposable inbox';
const heading = 'Your temporary inbox';
const sub = 'Use this receive-only inbox for permitted one-time messages. Platform acceptance and delivery are not guaranteed.';
---
<Layout title={title} description={description} imageAlt={imageAlt} additionalJsonLd={[webPageJsonLd, breadcrumbJsonLd]}>
  <Header inboxControls={!guideOnly} />

  <main class="page" id="top">
    <div class="page__inner">
      <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a> / <a href="/use-case/">Platform guides</a> / <span aria-current="page">{platform.name}</span></nav>
      <UseCaseHero platform={platform} />

      {platform.slug === 'discord' && <nav class="guide-jumps" aria-label="Discord guide sections"><span>Need help with Discord?</span><a href="#discord-verification">Choose your verification step</a><a href="#discord-email">Resend an email</a><a href="#discord-server">Server requirements</a></nav>}
      {platform.slug === 'github' && <>
        <nav class="guide-jumps" aria-label="GitHub guide sections"><span>Choose your task</span><a href="#github-account">Verify account email</a><a href="#github-privacy">Protect commit email</a><a href="#github-check">Check a commit</a></nav>
        <GitHubEmailGuide />
      </>}
      {platform.slug === 'chatgpt' && <>
        <nav class="guide-jumps" aria-label="ChatGPT guide sections"><span>Choose your next step</span><a href="#chatgpt-login">Check sign-in method</a><a href="#chatgpt-code">Troubleshoot a code</a><a href="#chatgpt-change">Change account email</a></nav>
        <ChatGPTEmailGuide />
      </>}

      {platform.slug === 'venmo' && <VenmoEmailGuide />}
      {platform.slug === 'steam' && <SteamEmailGuide />}

      {!guideOnly && <section class="grid">
        <div class="grid__col grid__col--address">
          <AddressCard kicker={kicker} heading={heading} sub={sub} headingLevel="h2" />
        </div>
        <div class="grid__col grid__col--postbox">
          <Postbox />
        </div>
      </section>}

      {platform.slug === 'discord' ? <DiscordVerificationGuide /> : !['github', 'chatgpt', 'venmo', 'steam'].includes(platform.slug) && <UseCaseHowItWorks platform={platform} />}
      {!['github', 'chatgpt', 'venmo', 'steam'].includes(platform.slug) && <UseCaseFAQs platform={platform} />}
      <UseCaseRelated platform={platform} />

      <footer class="foot">
        <div class="foot__inner">
          <nav class="foot__nav" aria-label="footer">
            <a href="/">Home</a>
            <a href="/use-case/">All platforms</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            {!guideOnly && <a href="#" data-tour-replay>Show me how</a>}
          </nav>
          <div class="foot__base">
            <span>© <span id="year">2026</span> InboxForNow</span>
            <span class="foot__sep" aria-hidden="true">·</span>
            <span>Built on Cloudflare Workers · receive-only · no IP logs</span>
            <span class="foot__sep" aria-hidden="true">·</span>
            <span>We use localStorage to remember your theme. We do not set tracking cookies.</span>
          </div>
        </div>
      </footer>
    </div>
  </main>

  {!guideOnly && <><EmailReader /><OnboardingTour /></>}
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    document.getElementById('year')!.textContent = new Date().getFullYear().toString();
  </script>

  <style>
    .guide-jumps { display: flex; flex-wrap: wrap; gap: .6rem 1.3rem; margin: calc(-1 * var(--sp-5)) 0 var(--sp-7); font-size: var(--fs-small); line-height: 1.6; }
    .guide-jumps span { color: var(--text-2); }
    .breadcrumb { margin-bottom: var(--sp-5); color: var(--text-2); font-size: var(--fs-small); }
    .page { padding: clamp(2rem, 1.2rem + 3vw, 4rem) clamp(1rem, 0.5rem + 2vw, 2.2rem) clamp(2rem, 3vw, 4rem); }
    .page__inner { max-width: 1320px; margin: 0 auto; }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
      align-items: start;
      padding-bottom: var(--sp-7);
      border-bottom: 1px solid var(--border);
    }
    .grid__col { min-width: 0; }
    @media (max-width: 960px) {
      .grid {
        grid-template-columns: 1fr;
        gap: clamp(2.5rem, 5vw, 3.5rem);
      }
    }

    .foot {
      margin-top: var(--sp-7);
      padding-top: var(--sp-7);
      border-top: 1px solid var(--border);
    }
    .foot__inner {
      display: flex;
      flex-direction: column;
      gap: var(--sp-5);
    }
    .foot__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.4rem;
    }
    .foot__nav a {
      color: var(--text-2);
      text-decoration: none;
      font-size: var(--fs-small);
    }
    .foot__nav a:hover { color: var(--text); }
    .foot__base {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-top: var(--sp-4);
      border-top: 1px solid var(--border);
      font-size: var(--fs-micro);
      color: var(--text-3);
      flex-wrap: wrap;
    }
    .foot__sep { color: var(--text-4); }

    /* Envelope card styling — re-declared since this page also has the inbox.
       (Both index and [slug] include the same component, but Astro scopes
        styles per file. Globals live in global.css.) */
    :global(.envelope) { margin: 0; padding: 0; list-style: none; }
    :global(.envelope__btn) {
      width: 100%;
      appearance: none;
      cursor: pointer;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-md);
      padding: 0.7rem 0.85rem;
      display: grid;
      grid-template-columns: 32px 1fr auto;
      gap: 0.7rem;
      align-items: center;
      text-align: left;
      color: var(--text);
      box-shadow: var(--shadow-1);
      transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease, transform .15s var(--ease-out);
    }
    :global(.envelope__btn:hover) {
      border-color: var(--border-strong);
      background: var(--surface-2);
    }
    :global(.envelope__btn:focus-visible) {
      outline: none;
      box-shadow: var(--ring);
      border-color: var(--border-focus);
    }
    :global(.envelope--new .envelope__btn) {
      border-color: var(--data-border);
      background: linear-gradient(0deg, var(--data-soft) 0%, var(--surface) 80%);
    }
    :global(.envelope--enter) { animation: envelopeEnter .55s var(--ease-out) both; }
    @keyframes envelopeEnter {
      0%   { opacity: 0; transform: translateY(-10px) scale(0.98); }
      60%  { opacity: 1; }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    :global(.envelope__stamp) {
      width: 32px; height: 32px;
      border-radius: var(--r-sm);
      background: var(--surface-2);
      border: 1px solid var(--border);
      display: grid; place-items: center;
      font-family: var(--ff-sans);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--text-2);
    }
    :global(.envelope--new .envelope__stamp) {
      background: var(--surface);
      border-color: var(--data-border);
      color: var(--data-2);
    }
    :global(.envelope__body) { min-width: 0; display: flex; flex-direction: column; gap: 0.05rem; }
    :global(.envelope__top) { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
    :global(.envelope__from) { font-weight: 600; font-size: var(--fs-small); color: var(--text); letter-spacing: -0.01em; }
    :global(.envelope__time) { font-family: var(--ff-mono); font-size: 0.7rem; color: var(--text-3); white-space: nowrap; }
    :global(.envelope__subject) { font-size: var(--fs-small); color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
    :global(.envelope__bottom) { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
    :global(.envelope__preview) { font-size: 0.8125rem; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1 1 auto; min-width: 0; }
    :global(.envelope__code) {
      font-family: var(--ff-mono); font-size: 0.72rem; font-weight: 600;
      color: var(--data-2); background: var(--data-soft);
      border: 1px solid var(--data-border);
      padding: 0.12rem 0.4rem; border-radius: var(--r-sm);
      letter-spacing: 0.04em; flex-shrink: 0;
    }
    :root[data-theme="dark"] :global(.envelope__code) { color: var(--data); }
    :global(.envelope__dot) {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--data); box-shadow: 0 0 0 3px var(--data-soft);
      align-self: center; flex-shrink: 0;
    }
    :global(.btn--flash) { animation: copyFlash .4s var(--ease-out); }
    @keyframes copyFlash {
      0%   { box-shadow: var(--shadow-2); }
      40%  { box-shadow: var(--ring-data); }
      100% { box-shadow: var(--shadow-2); }
    }
  </style>

  <script>
    document.getElementById('year')!.textContent = new Date().getFullYear().toString();
  </script>

  <script src="../../scripts/app.ts"></script>
  <script src="../../scripts/pwa.ts"></script>
</Layout>
