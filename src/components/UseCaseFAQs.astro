---
import type { Platform } from '~/data/platforms';

interface Props { platform: Platform; }
const { platform } = Astro.props;

const faqs: Array<{ q: string; a: string; link?: { href: string; text: string } }> = [
  {
    q: `Does temporary email work with ${platform.name}?`,
    a: platform.suitability === 'blocked'
      ? 'GitHub documents that disposable email addresses cannot be verified. Use a permanent account address; GitHub’s noreply address can protect commit privacy.'
      : platform.suitability === 'phone-required'
      ? 'A temporary email cannot replace the phone number linked to a Telegram account. Keep control of the connected phone number and use lasting recovery details.'
      : platform.suitability === 'permanent-email'
      ? `We recommend permanent email for ${platform.name}. An expiring inbox is unsuitable for financial account access, recovery, or records.`
      : `We have not verified whether ${platform.name} accepts our current receiving domain. Acceptance can change, and an email inbox cannot replace a required phone number or another verification step.`,
  },
  {
    q: 'What should I do if an email does not arrive?',
    a: 'Check the copied address, your connection, and the inbox timer. A sender may delay mail or reject the domain. A new address may use the same receiving domain and will not reliably fix a rejection. Use a supported permanent address if required.',
    link: { href: '/guides/email-not-arriving/', text: 'Follow the missing-email checklist' },
  },
  {
    q: `Can I recover my ${platform.name} account after the inbox expires?`,
    a: 'This inbox cannot receive recovery emails after expiry. Saving a password does not ensure future access: another email verification may be required. Use a permanent email or lasting forwarding alias for an account you want to keep.',
  },
  {
    q: `Does ${platform.name} permit disposable addresses?`,
    a: 'Consult the platform’s current terms and account requirements. This page does not establish permission or compatibility. InboxForNow is intended for permitted one-time messages and testing, and does not bypass platform requirements.',
  },
];
---
<section class="uc-faqs" aria-labelledby="uc-faqs-heading">
  <div class="uc-faqs__head">
    <span class="label"><span class="label__dot label__dot--idle" aria-hidden="true"></span>Common questions</span>
    <h2 id="uc-faqs-heading">FAQ · temp mail for {platform.name}</h2>
  </div>

  <div class="uc-faqs__list">
    {faqs.map((f) => (
      <details class="uc-faq">
        <summary class="uc-faq__q">
          <span>{f.q}</span>
          <svg class="uc-faq__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <p class="uc-faq__a">{f.a}{f.link && <>{' '}<a href={f.link.href}>{f.link.text}</a>.</>}</p>
      </details>
    ))}
  </div>
</section>


<style>
  .uc-faqs {
    padding: var(--sp-8) 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .uc-faqs__head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .uc-faqs__head h2 {
    font-size: var(--fs-h2);
    margin: 0;
    color: var(--text);
  }

  .uc-faqs__list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .uc-faq {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: border-color .15s ease;
  }
  .uc-faq:hover {
    border-color: var(--border-strong);
  }
  .uc-faq[open] {
    border-color: var(--border-strong);
  }

  .uc-faq__q {
    list-style: none;
    cursor: pointer;
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    font-weight: 500;
    font-size: var(--fs-body);
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .uc-faq__q::-webkit-details-marker { display: none; }
  .uc-faq__chev {
    color: var(--text-3);
    transition: transform .2s var(--ease-out);
    flex-shrink: 0;
  }
  .uc-faq[open] .uc-faq__chev {
    transform: rotate(180deg);
    color: var(--text);
  }

  .uc-faq__a {
    margin: 0;
    padding: 0 var(--sp-5) var(--sp-4);
    color: var(--text-2);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
</style>
